<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <RootNamespace>PythonEmbedded.Net.Runners.PythonNet</RootNamespace>
        <Title>PythonEmbedded.Net.Runners.PythonNet</Title>
        <Description>In-process Python execution for PythonEmbedded.Net via Python.NET — no subprocess overhead, plus direct .NET/Python object interop.</Description>
        <Authors>Christian Webber</Authors>
        <Company>Christian Webber</Company>
        <Copyright>(c) 2026</Copyright>
        <PackageProjectUrl>https://github.com/vonderborch/PythonEmbedded.Net</PackageProjectUrl>
        <RepositoryUrl>https://github.com/vonderborch/PythonEmbedded.Net</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>logo.png</PackageIcon>
        <PackageTags>Python, Local, Embedded, PythonNet, Interop</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PythonEmbedded.Net\PythonEmbedded.Net.csproj" />
        <PackageReference Include="pythonnet" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\logo.png" Pack="True" PackagePath="" Link="logo.png" />
    </ItemGroup>
</Project>
