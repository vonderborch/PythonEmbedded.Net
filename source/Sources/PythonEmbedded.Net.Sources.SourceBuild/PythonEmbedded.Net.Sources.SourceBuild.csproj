<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>PythonEmbedded.Net.Sources.SourceBuild</RootNamespace>
        <Title>PythonEmbedded.Net.Sources.SourceBuild</Title>
        <Description>Compiles CPython from official python.org source tarballs for PythonEmbedded.Net.</Description>
        <Authors>Christian Webber</Authors>
        <Company>Christian Webber</Company>
        <Copyright>(c) 2026</Copyright>
        <PackageProjectUrl>https://github.com/vonderborch/PythonEmbedded.Net</PackageProjectUrl>
        <RepositoryUrl>https://github.com/vonderborch/PythonEmbedded.Net</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>logo.png</PackageIcon>
        <PackageTags>Python, Local, Embedded, Source, Build, CPython</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>2.0.0.46</Version>
        <AssemblyVersion>2.0.0.46</AssemblyVersion>
        <FileVersion>2.0.0.46</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PythonEmbedded.Net\PythonEmbedded.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\logo.png" Pack="True" PackagePath="" Link="logo.png" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PythonEmbedded.Net.IntegrationTest" />
    </ItemGroup>
</Project>
