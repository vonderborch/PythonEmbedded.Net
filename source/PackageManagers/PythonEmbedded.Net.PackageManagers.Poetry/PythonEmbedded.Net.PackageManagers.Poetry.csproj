<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <RootNamespace>PythonEmbedded.Net.PackageManagers.Poetry</RootNamespace>
        <Title>PythonEmbedded.Net.PackageManagers.Poetry</Title>
        <Description>Poetry-backed dependency installation (pyproject.toml projects) for PythonEmbedded.Net.</Description>
        <Authors>Christian Webber</Authors>
        <Company>Christian Webber</Company>
        <Copyright>(c) 2026</Copyright>
        <PackageProjectUrl>https://github.com/vonderborch/PythonEmbedded.Net</PackageProjectUrl>
        <RepositoryUrl>https://github.com/vonderborch/PythonEmbedded.Net</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>logo.png</PackageIcon>
        <PackageTags>Python, Local, Embedded, Poetry</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PythonEmbedded.Net\PythonEmbedded.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\logo.png" Pack="True" PackagePath="" Link="logo.png" />
    </ItemGroup>
</Project>
