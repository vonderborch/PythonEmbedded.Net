<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>2.0.0.46</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>PythonEmbedded.Net</Title>
        <Authors>Christian Webber</Authors>
        <Description>A local/embedded Python instance manager.</Description>
        <Copyright>(c) 2025</Copyright>
        <PackageProjectUrl>https://github.com/vonderborch/PythonEmbedded.Net</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>
        <RepositoryUrl>https://github.com/vonderborch/PythonEmbedded.Net</RepositoryUrl>
        <PackageTags>Python, Local, Embedded</PackageTags>
        <AssemblyVersion>2.0.0.46</AssemblyVersion>
        <FileVersion>2.0.0.46</FileVersion>
        <Company>Christian Webber</Company>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>..\..\debug\core</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <OutputPath>..\..\release\core</OutputPath>
      <DocumentationFile>..\..\release\core\PythonEmbedded.Net.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PythonEmbedded.Net.Test" />
        <InternalsVisibleTo Include="PythonEmbedded.Net.IntegrationTest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>README.md</Link>
        </None>
        <None Include="..\..\logo.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
            <Link>logo.png</Link>
        </None>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="python3 -c &quot;import shutil; shutil.make_archive('$(SolutionDir)release/$(ProjectName)', 'zip', '$(TargetDir)')&quot;" Condition="'$(ConfigurationName)' == 'Release'"/>
    </Target>
</Project>
